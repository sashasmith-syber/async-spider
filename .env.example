# Optional Compose profiles only. The crawler reads config.json, not this file.
# Copy to .env and replace the example values. .env is gitignored.

# Required only for: docker compose -f docker-compose.yml -f docker-compose.optional.yml --profile postgres up
DB_PASSWORD=example-not-a-real-password

# Required only for the monitoring profile's Grafana service.
GRAFANA_PASSWORD=example-not-a-real-password

# The crawler does not use these ports. Host bindings in the optional file are localhost-only.
METRICS_PORT=8080
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
